# Override ssh-chatter runtime defaults by editing and uncommenting the values below.
# CHATTER_BIND_ADDRESS=0.0.0.0
# CHATTER_PORT=2222
# CHATTER_MOTD_FILE=/etc/ssh-chatter/motd
# CHATTER_HOST_KEY_DIR=/var/lib/ssh-chatter
# CHATTER_USER_DATA_ROOT=/var/lib/ssh-chatter/user-data
# CHATTER_PW_AUTH_FILE=/var/lib/ssh-chatter/pw_auth.dat
# CHATTER_NICKNAME_CLAIM_FILE=/var/lib/ssh-chatter/nickname_claims.dat
# CHATTER_AI_MEMORY_FILE=/var/lib/ssh-chatter/ai_chat_memory.dat
# CHATTER_RUNTIME_SETTINGS_FILE=/var/lib/ssh-chatter/runtime_settings.dat
# CHATTER_WELCOME_BANNER=/etc/ssh-chatter/logo.ans
# CHATTER_EXTRA_ARGS=

# Memory allocation cap. Set to 0/unlimited/inf/infinity to remove any per-allocation
# limit (recommended for long-running production instances).
# CHATTER_MAX_ALLOC_BYTES=0

# Translation settings
# GEMINI_API_KEY=
# OLLAMA_ADDRESS=127.0.0.1:11434
# GEMINI_MODEL=gemini-2.5-flash-lite

# BBS comment moderation (set to 0/false/no to disable; enabled by default)
# CHATTER_BBS_COMMENT_EDIT=1
# CHATTER_BBS_COMMENT_DELETE=1

# FidoNet node (see docs/FIDONET.md). Off unless CHATTER_FIDO_ADDRESS is set.
# Mail moves at the Zone Mail Hour of our zone unless CHATTER_FIDO_ZMH is set.
# CHATTER_FIDO_ADDRESS=2:5020/1042
# CHATTER_FIDO_UPLINK=2:5020/1
# CHATTER_FIDO_UPLINK_HOST=hub.example.org:24554
# CHATTER_FIDO_PASSWORD=
# CHATTER_FIDO_AREAS=FIDOTEST
# CHATTER_FIDO_ZMH=02:30-03:30
# CHATTER_FIDO_POLL_MINUTES=0
# CHATTER_FIDO_BINKP_PORT=off
# CHATTER_FIDO_ORIGIN=SSH-Chatter BBS

# Door games config (e.g. lord, lord2)
# CHATTER_DOOR_1=lord:/var/lib/ssh-chatter/doors/lord/dosbox.conf:Legend of the Red Dragon
# CHATTER_DOOR_2=lord2:/var/lib/ssh-chatter/doors/lord2/dosbox.conf:Legend of the Red Dragon II
